{
  "name": "agda-mode-telemetry",
  "displayName": "Agda Mode Telemetry",
  "description": "Record every agda-mode command, Agda response and buffer state to SQLite, in the same format as the Emacs agda2-telemetry. Share it as a zip or a Markdown trace.",
  "version": "0.1.0",
  "publisher": "kiranandcode",
  "icon": "images/icon.png",
  "license": "MIT",
  "author": {
    "name": "Kiran Gopinathan"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/kiranandcode/agda-mode-telemetry-vscode"
  },
  "bugs": {
    "url": "https://github.com/kiranandcode/agda-mode-telemetry-vscode/issues"
  },
  "homepage": "https://github.com/kiranandcode/agda-mode-telemetry-vscode#readme",
  "keywords": [
    "agda",
    "telemetry",
    "proof",
    "theorem proving",
    "agda-mode",
    "research"
  ],
  "galleryBanner": {
    "color": "#1e1e2e",
    "theme": "dark"
  },
  "engines": {
    "vscode": "^1.101.0"
  },
  "categories": [
    "Programming Languages",
    "Data Science",
    "Other"
  ],
  "extensionDependencies": [
    "banacorn.agda-mode"
  ],
  "activationEvents": [
    "onLanguage:agda",
    "onLanguage:lagda-markdown",
    "onLanguage:lagda-typst",
    "onLanguage:lagda-tex",
    "onLanguage:lagda-rst",
    "onLanguage:lagda-org",
    "onLanguage:lagda-forester",
    "workspaceContains:**/.agda-telemetry.db"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "configuration": {
      "title": "Agda Mode Telemetry",
      "properties": {
        "agdaTelemetry.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Record agda-mode telemetry to .agda-telemetry.db next to each Agda file."
        }
      }
    },
    "commands": [
      {
        "command": "agdaTelemetry.export",
        "title": "Export Telemetry\u2026",
        "category": "Agda Telemetry",
        "icon": "$(package)"
      },
      {
        "command": "agdaTelemetry.copySessionTrace",
        "title": "Copy Session Trace",
        "category": "Agda Telemetry"
      },
      {
        "command": "agdaTelemetry.openSessionTrace",
        "title": "Open Session Trace",
        "category": "Agda Telemetry"
      },
      {
        "command": "agdaTelemetry.revealDatabase",
        "title": "Reveal Database",
        "category": "Agda Telemetry"
      },
      {
        "command": "agdaTelemetry.pause",
        "title": "Pause Recording",
        "category": "Agda Telemetry",
        "enablement": "config.agdaTelemetry.enabled"
      },
      {
        "command": "agdaTelemetry.resume",
        "title": "Resume Recording",
        "category": "Agda Telemetry",
        "enablement": "!config.agdaTelemetry.enabled"
      },
      {
        "command": "agdaTelemetry.menu",
        "title": "Show Menu",
        "category": "Agda Telemetry"
      }
    ]
  },
  "scripts": {
    "build": "esbuild src/extension.ts --bundle --platform=node --format=cjs --target=node22 --external:vscode --external:node:sqlite --outfile=dist/extension.js",
    "watch": "npm run build -- --watch",
    "typecheck": "tsc --noEmit",
    "test": "npm run test:unit && npm run test:e2e",
    "package": "npm run build && vsce package --no-dependencies",
    "test:unit": "esbuild test/unit.test.ts --bundle --platform=node --outfile=dist/unit.test.js && node --test dist/unit.test.js",
    "test:e2e": "npm run build && node test/e2e/run.mjs",
    "vscode:prepublish": "npm run build -- --minify",
    "demo": "npm run build && node test/demo/run.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "@types/vscode": "~1.101.0",
    "@vscode/test-electron": "^2.5.2",
    "diff": "^9.0.0",
    "esbuild": "^0.28.2",
    "typescript": "^5.9.0",
    "@vscode/vsce": "^3.6.0",
    "ovsx": "^0.10.0"
  }
}
